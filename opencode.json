{
  "$schema": "https://opencode.ai/config.json",
  "lsp": {
    "air": {
      "command": ["air", "language-server"],
      "extensions": [".R", ".Rmd"]
    },
    "ruff": {
      "command": ["ruff", "server"],
      "extensions": [".py"]
    },
    "ty": {
      "command": ["ty", "server"],
      "extensions": [".py"]
    },
    "pyright": {
      "disabled": true
    }
  },
  "mcp": {
    "grep_app": {
      "type": "remote",
      "url": "https://mcp.grep.app",
      "enabled": true
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
      },
      "enabled": true
    }
  }
}
