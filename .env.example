# Secrets for the binary-classifier pipeline. Copy to the PROJECT drive as
# /work/<PROJECT_DRIVE>/.env (never the shared corpus drive, never committed).

# OpenAI API key — stage 02 bake-off / OpenAI annotation arm.
OPENAI_API_KEY=your_key_here

# HuggingFace token — required to download the gated open-weight annotator
# (google/gemma-3-27b-it) and read by `hf download` / vLLM.
HF_TOKEN=your_hf_token_here

# GitHub fine-grained PAT — seeds git's HTTPS credential store in utils/init.sh
# so pull/commit/push work in the project-drive checkout.
GITHUB_TOKEN=your_github_pat_here

# Anthropic API key — only for the optional dev/agent overlay (utils/devenv.sh:
# Claude Code + opencode independent review). Not needed by batch/GPU jobs.
ANTHROPIC_API_KEY=your_anthropic_key_here
