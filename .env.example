# Bootstrap configuration AND secrets for the binary-classifier pipeline.
# Copy to the PROJECT drive as /work/<PROJECT_DRIVE>/.env (never the shared
# corpus drive, never committed). This is the single source of truth for drive
# names, git identity, and secrets — edit once, no other config file needs it.
# NOTE: quote values containing spaces (e.g. GIT_NAME="First Last").
# Secrets (API keys, tokens) need no quoting unless they contain spaces.

# ── UCloud drive names ────────────────────────────────────────────────────────
# Observe the real names with `ls /work` on a live job (member-files drives
# often mount with a #NNNN suffix). These are the bare directory names, no
# `/work/` prefix.
DATA_DRIVE=CHANGE_ME_DATA_DRIVE
PROJECT_DRIVE=CHANGE_ME_PROJECT_DRIVE

# ── Git identity for commits made from UCloud ─────────────────────────────────
GIT_NAME="YOUR_NAME"
GIT_EMAIL="YOUR_EMAIL"

# ── LLM serving (vLLM, OpenAI-compatible) ─────────────────────────────────────
# Two roles can run concurrently on one B200 (183 GB), each on its own port. On
# a multi-B200 UCloud node, you can also start separate vLLM servers manually
# with `CUDA_VISIBLE_DEVICES=<gpu-list>` and different ports.
# Start with:  utils/serve-llm.sh annotate | coding | both
#
#   annotate — the open-weight Gemma arm for pipeline stages 02/03. The model id
#              is NOT set here: it is read from the vLLM bake-off candidate in
#              config/religious_missions.yaml, the single source of truth shared
#              with the annotator client (avoids server/client model drift).
#   coding   — interactive dev assistant (Opencode); any instruct/coder model.
LLM_ANNOTATE_PORT=8000
LLM_ANNOTATE_MAX_MODEL_LEN=8192

# LLM_CODING_MODEL accepts ANY instruct/coder model id -- swapping it back and
# forth is a one-line change here, nothing to edit in serve-llm.sh. Two tested
# options:
#   - "Qwen/Qwen3.6-35B-A3B" (default): small, co-locates fine with `annotate`
#     via `serve-llm.sh both` on one B200.
#   - "deepseek-ai/DeepSeek-V4-Flash": much stronger, but ~146 GiB of weights
#     means it needs a full B200 to itself (LLM_TENSOR_PARALLEL=1 is enough;
#     `both` mode will NOT fit it alongside annotate on the same GPU). The
#     model-specific vLLM flags (tokenizer/reasoning/tool-call parsers,
#     fp8 KV cache) are applied automatically by serve-llm.sh when this id is
#     configured -- see docs/UCLOUD_CODING_LLM.md for the full sizing math and
#     docs/RUNNING_ON_UCLOUD.md for the underlying cutlass-dsl wheel diagnosis.
LLM_CODING_MODEL="Qwen/Qwen3.6-35B-A3B"
LLM_CODING_PORT=8001
LLM_CODING_MAX_MODEL_LEN=8192

# Shared serving knobs.
LLM_TENSOR_PARALLEL=1
LLM_API_KEY="sk-ucloud"

# Per-server VRAM fraction when BOTH roles share one GPU (`serve-llm.sh both`).
# A single role serves at LLM_GPU_MEM_UTIL_SOLO (default 0.95) automatically.
LLM_GPU_MEM_UTIL=0.45

# CUDA module loaded by utils/init.sh so FlashInfer can JIT-compile sm_100
# (Blackwell/B200) kernels. Override only if the platform exposes a different
# CUDA ≥12.8 module name (12.6 and older cannot compile compute_100a).
CUDA_MODULE="CUDA/12.8.0"

# ── Network ───────────────────────────────────────────────────────────────────
# Static public IP allocated in UCloud (Resources → IP addresses). One-time
# allocation; attach the same IP resource at every job submission. Leave empty
# if using only job-local access (no laptop access needed).
# e.g. "130.225.164.42"
UCLOUD_PUBLIC_IP=""

# ── Secrets ───────────────────────────────────────────────────────────────────

# OpenAI API key — stage 02 bake-off / OpenAI annotation arm.
OPENAI_API_KEY=your_key_here

# HuggingFace token — required to download the gated open-weight annotator
# (google/gemma-3-27b-it) and read by `hf download` / vLLM.
HF_TOKEN=your_hf_token_here

# GitHub fine-grained PAT — seeds git's HTTPS credential store in utils/init.sh
# so pull/commit/push work in the project-drive checkout.
GITHUB_TOKEN=your_github_pat_here

# Anthropic API key — only for the optional dev/agent overlay (utils/devenv.sh:
# Claude Code + opencode independent review). Not needed by batch/GPU jobs.
ANTHROPIC_API_KEY=your_anthropic_key_here
